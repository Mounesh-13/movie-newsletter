TMDB_API_KEY=
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=
RESEND_API_KEY=
# Required for signups AND broadcasts: same newsletter Segment ID in Vercel and GitHub Actions
RESEND_AUDIENCE_ID=
# Required: verified sender, e.g. Movie Newsletter <news@yourdomain.com>
# (Resend's onboarding@resend.dev only delivers to the account owner.)
RESEND_FROM=

# Free Gmail OAuth sending (no domain/App Password). See GMAIL_SETUP.md.
# EMAIL_PROVIDER=gmail
# GMAIL_USER=yourname@gmail.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# ONLY if all active Resend contacts signed up for this newsletter:
# NEWSLETTER_CONTACT_SOURCE=all
